# PQC-Ready Analyzer - Ortam Değişkenleri Örneği
# Bu dosyayı .env olarak kopyala ve değerleri doldur

# OpenAI API
OPENAI_API_KEY=sk-...your-api-key-here...
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_TEMPERATURE=0.3

# HuggingFace API (isteğe bağlı)
HUGGINGFACE_API_KEY=hf_...
HUGGINGFACE_MODEL=mistralai/Mistral-7B-v0.1

# Ollama (Local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/analyzer.log

# Output
OUTPUT_DIR=./output
TEMP_DIR=/tmp/pqc-analyzer

# Analysis
LLM_PROVIDER=mock
USE_LLM=false
ENABLE_BINARY_ANALYSIS=true
ENABLE_SOURCE_CODE_ANALYSIS=true
